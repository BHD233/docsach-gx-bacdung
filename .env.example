# Chuỗi kết nối Postgres (Neon). Trên Vercel: Storage → Neon → tự thêm DATABASE_URL.
# Để trống khi chạy local → dùng PGlite lưu ở ./.data
DATABASE_URL=

# Mật khẩu đăng nhập admin (local mặc định: admin)
ADMIN_PASSWORD=admin

# Chuỗi bí mật ký cookie phiên đăng nhập — tạo bằng: openssl rand -base64 32
AUTH_SECRET=
